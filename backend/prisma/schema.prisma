generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id         Int                  @id @default(autoincrement())
  nombre     String
  orden      Int                  @default(0)
  activa     Boolean              @default(true)
  eliminado  Boolean              @default(false)
  productos  Producto[]
  descuentos DescuentoCategoria[]
  creadaEn   DateTime             @default(now()) @map("creada_en")

  @@map("categorias")
}

model DescuentoCategoria {
  id             Int       @id @default(autoincrement())
  categoriaId    Int       @map("categoria_id")
  categoria      Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  cantidadMinima Int       @map("cantidad_minima")
  porcentaje     Float

  @@map("descuentos_categoria")
}

model Banner {
  id     Int     @id @default(autoincrement())
  titulo String  @default("Descuento en compras por mayor!")
  linea1 String  @default("+5 unidades: 5% de descuento")
  linea2 String  @default("+10 unidades: 25% de descuento")
  activo Boolean @default(true)

  @@map("banner")
}

model Producto {
  id           Int           @id @default(autoincrement())
  categoriaId  Int           @map("categoria_id")
  categoria    Categoria     @relation(fields: [categoriaId], references: [id])
  nombre       String
  descripcion  String?
  precio       Decimal       @db.Decimal(10, 2)
  precioUnidad Decimal?      @db.Decimal(10, 2) @map("precio_unidad")
  fotoUrl      String?       @map("foto_url")
  fotoPublicId String?       @map("foto_public_id")
  disponible   Boolean       @default(true)
  eliminado    Boolean       @default(false)
  orden        Int           @default(0)
  stock        Int           @default(0)
  stockMinimo  Int           @default(0) @map("stock_minimo")
  creadoEn     DateTime      @default(now()) @map("creado_en")
  items        ItemVenta[]
  ajustes      AjusteStock[]
  itemsPedido  ItemPedido[]

  @@map("productos")
}

model Venta {
  id       Int         @id @default(autoincrement())
  fecha    DateTime    @default(now())
  total    Decimal     @db.Decimal(10, 2)
  notas    String?
  items    ItemVenta[]
  pedido   Pedido?
  creadaEn DateTime    @default(now()) @map("creada_en")

  @@map("ventas")
}

enum EstadoPedido {
  pendiente
  por_entregar
  entregado
  cancelado
}

enum MetodoPago {
  efectivo
  transferencia
  mercadopago
}

enum EstadoPago {
  pendiente
  pagado
}

model Pedido {
  id            Int           @id @default(autoincrement())
  estado        EstadoPedido  @default(pendiente)
  nombre        String
  telefono      String?
  direccion     String?
  notas         String?
  fechaEntrega  DateTime      @map("fecha_entrega")
  total         Decimal       @db.Decimal(10, 2)
  metodoPago    MetodoPago    @default(efectivo) @map("metodo_pago")
  estadoPago    EstadoPago    @default(pendiente) @map("estado_pago")
  mpPaymentId   String?       @unique @map("mp_payment_id")
  ventaId       Int?          @unique @map("venta_id")
  venta         Venta?        @relation(fields: [ventaId], references: [id])
  items         ItemPedido[]
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  @@map("pedidos")
}

model ItemPedido {
  id             Int      @id @default(autoincrement())
  pedidoId       Int      @map("pedido_id")
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     Int      @map("producto_id")
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2) @map("precio_unitario")

  @@map("items_pedido")
}

model ItemVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int      @map("producto_id")
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2) @map("precio_unitario")

  @@map("items_venta")
}

model AjusteStock {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int
  motivo     String
  fecha      DateTime @default(now())

  @@map("ajustes_stock")
}

model PushSubscription {
  id       Int    @id @default(autoincrement())
  endpoint String @unique
  p256dh   String
  auth     String

  @@map("push_subscriptions")
}

model NotificationConfig {
  id               Int     @id @default(autoincrement())
  enabled          Boolean @default(true)
  notificationTime String  @default("21:00")
  lastSentDate     String?

  @@map("notification_config")
}

model DeliveryConfig {
  id   Int       @id @default(autoincrement())
  dias Boolean[] @default([true, true, true, true, true, true, false])

  @@map("delivery_config")
}

model MercadoPagoConnection {
  id            Int      @id @default(autoincrement())
  accessToken   String   @map("access_token")
  refreshToken  String   @map("refresh_token")
  publicKey     String   @map("public_key")
  mpUserId      String   @map("mp_user_id")
  expiresAt        DateTime @map("expires_at")
  intentosFallidos Int      @default(0) @map("intentos_fallidos")
  conectadoEn      DateTime @default(now()) @map("conectado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("mercado_pago_connections")
}
