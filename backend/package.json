{
  "name": "empanadas-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "db:generate": "dotenv -e .env.development -- prisma generate",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "db:seed": "cross-env NODE_ENV=development tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.6.0",
    "cloudinary": "^2.5.1",
    "dotenv": "^17.4.2",
    "hono": "^4.7.7",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.3.0",
    "node-cron": "^4.2.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
